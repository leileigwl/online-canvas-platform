# Local development defaults. Never use the development key in production.
APP_ENV=development
APP_SECRET_KEY=development-only-change-this-key
DATABASE_URL=sqlite+aiosqlite:///./flowcanvas.db
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_ENABLED=true
AUTO_CREATE_SCHEMA=true
COOKIE_SECURE=false
SESSION_DAYS=30
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_BYTES=12582912
MAX_ACTIVE_AGENT_RUNS_PER_USER=3
MAX_AGENT_MODEL_CALLS_PER_RUN=12
AGENT_MODEL_COMPLETION_TOKENS_PER_CALL=2048
CHAT_COMPLETION_TOKEN_LIMIT_FIELD=max_tokens

# Local files are the default. For MinIO/S3 set ASSET_STORAGE=s3 and fill these in.
ASSET_STORAGE=local
ASSET_LOCAL_PATH=./data/assets
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=flowcanvas-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP email verification (e.g. 163 mail SSL port 465). Keep credentials out of git.
SMTP_ENABLED=false
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FlowCanvas
SMTP_USE_SSL=true
