# Copy to the repository root as .env and replace all example secrets before use.
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_DB=flowcanvas
POSTGRES_USER=flowcanvas
POSTGRES_PASSWORD=replace-with-a-long-hex-secret
REDIS_PASSWORD=replace-with-a-long-hex-secret

MINIO_ROOT_USER=flowcanvas-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-hex-secret
S3_ACCESS_KEY=flowcanvas-app
S3_SECRET_KEY=replace-with-another-long-hex-secret

MAX_UPLOAD_BYTES=12582912
MAX_ACTIVE_AGENT_RUNS_PER_USER=3
MAX_AGENT_MODEL_CALLS_PER_RUN=12
AGENT_MODEL_COMPLETION_TOKENS_PER_CALL=2048
CHAT_COMPLETION_TOKEN_LIMIT_FIELD=max_tokens
